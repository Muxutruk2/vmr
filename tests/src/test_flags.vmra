aEXPORT START:
; --- SETUP ---
MOV_IMM R0, 0x01      ; Default to FAIL status (1)

; --- TEST 1: ADD & CARRY ---
MOV_IMM R1, 0xFFFF
MOV_IMM R2, 0x0001
ADD R1, R2      ; Flags: Equals=1, Carry=1

JNZ .FAIL       ; Jump if Not Zero (If Equals is 0, fail)
JNC .FAIL       ; Jump if No Carry (If Carry is 0, fail) 
                ; JB would jump here because Carry is 1. We want to NOT jump.

; --- TEST 2: SUB & CARRY (BORROW) ---
; 10 - 20 should result in a wrap-around and set CARRY (Borrow)
MOV_IMM R1, 10
MOV_IMM R2, 20
SUB R1, R2            ; R1 = 65526, Carry = 1, Negative = 1
JNC .FAIL             ; Must have Carry/Borrow
JAE .FAIL             ; 10 is NOT Above or Equal to 20

; --- TEST 3: CMP & JA (Jump if Above) ---
MOV_IMM R1, 100
MOV_IMM R2, 50
CMP R1, R2            ; 100 > 50
JA .TEST_4            ; Should jump
JMP .FAIL             ; If it didn't jump, fail

; --- TEST 4: CMP & JB (Jump if Below) ---
TEST_4:
MOV_IMM R1, 50
MOV_IMM R2, 100
CMP R1, R2            ; 50 < 100
JB .TEST_5            ; Should jump (Carry/Borrow set)
JMP .FAIL

; --- TEST 5: NEGATIVE FLAG ---
TEST_5:
; Even in unsigned, the Negative flag usually tracks Bit 15.
MOV_IMM R1, 0x8000    ; Binary: 1000 0000 0000 0000
ADD_IMM R1, 0x0000    ; Update flags without changing value
JN .TEST_6            ; (Assuming Jump if Negative)
JMP .FAIL

TEST_6:
; --- SUCCESS ---
MOV_IMM R0, 0x00      ; Set R0 to 0 (Success!)
HALT
