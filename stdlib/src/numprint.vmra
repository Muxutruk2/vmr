; R1 = Number
; R2 = Address
; R3 = Base of the representation
EXPORT U16PRINTLN:
    PUSH R1
    PUSH R3
    CALL .U16MEM       ; R0 now holds digit count
    
    ; R7 = Start address + digit count
    MOV R7, R2
    ADD R7, R0         ; R7 now points to the first empty slot after digits
    
    STORE_R_IMM R7, 0x000A ; Append newline at the end
    
    ADD_IMM R0, 1      ; Increment count to include the newline
    MOV R3, R0         ; R3 = total length for SYSCALL
    MOV_IMM R1, 0x01   ; PRINT
    SYSCALL

    MOV_IMM R0, 0x00
    POP R3
    POP R1
    RET

; R1 = Number
; R2 = Buffer Address
; R3 = Base
; Returns R0 = Number of digits
EXPORT U16MEM:
    
    MOV R7, R2      ; Pointer
    MOV_IMM R6, 0   ; Counter

PUSH_DIGITS:
    DIV_MOD R3
    ADD_IMM R1, 48  ; Convert remainder to ASCII
    PUSH R1         ; Push digit onto stack
    ADD_IMM R6, 1   ; Increment count
    
    MOV R1, R0
    CMP_IMM R1, 0   
    JNZ .PUSH_DIGITS ; Check if quotient is zero

    ; At this point, R6 is the count and digits are on the stack.
    ; Pop them into memory starting at R2.
    MOV R0, R6      ; Prepare return value
    MOV R7, R2      ; Reset pointer to start of buffer

POP_DIGITS:
    POP R1
    STORE_R_R R7, R1
    ADD_IMM R7, 1
    SUB_IMM R6, 1
    CMP_IMM R6, 0
    JNZ .POP_DIGITS

    RET
